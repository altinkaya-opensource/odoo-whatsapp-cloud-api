<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_whatsapp_backend_tree" model="ir.ui.view">
        <field name="name">whatsapp.backend.tree</field>
        <field name="model">whatsapp.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="phone_number_id" />
                <field name="api_version" />
                <field name="active" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_backend_form" model="ir.ui.view">
        <field name="name">whatsapp.backend.form</field>
        <field name="model">whatsapp.backend</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Backend">
                <header>
                    <button
                        name="action_sync_templates"
                        string="Sync Templates"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('waba_id', '=', False)]}"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_templates"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field
                                name="template_count"
                                widget="statinfo"
                                string="Templates"
                            />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="active" />
                            <field name="main_backend" />
                            <field
                                name="company_id"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="language" />
                        </group>
                        <group>
                            <field name="phone_number_id" />
                            <field name="api_token" password="True" />
                            <field name="api_version" />
                            <field name="waba_id" />
                            <field name="webhook_secret" />
                            <field name="app_secret" password="True" />

                            <field name="frontend_webhook_url" />
                            <field name="frontend_webhook_secret" />
                        </group>
                    </group>
                    <notebook>
                        <page name="chatbot" string="Chatbot">
                            <group>
                                <field name="chatbot_enabled" />
                                <field
                                    name="chatbot_id"
                                    attrs="{'required': [('chatbot_enabled', '=', True)], 'invisible': [('chatbot_enabled', '=', False)]}"
                                />
                            </group>
                        </page>
                        <page name="users" string="Users">
                            <field
                                name="user_ids"
                                context="{'default_company_id': company_id}"
                                options="{'no_create': True}"
                            >
                                <kanban
                                    class="o_kanban_mobile o_m2m_kanban"
                                    quick_create="false"
                                >
                                    <field name="id" />
                                    <field name="name" />
                                    <field name="login" />
                                    <field name="lang" />
                                    <field name="im_status" />
                                    <field name="active" />
                                    <field name="login_date" />
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div t-attf-class="oe_kanban_global_click">
                                                <div class="o_kanban_image">
                                                    <img
                                                        alt="Avatar"
                                                        t-att-src="kanban_image('res.users', 'avatar_128', record.id.raw_value)"
                                                    />
                                                </div>
                                                <div class="oe_kanban_details">
                                                    <ul>
                                                        <li
                                                            class="text-success float-end mb4"
                                                            t-if="record.im_status.raw_value == 'online'"
                                                            title="Online"
                                                        >
                                                            <i
                                                                class="fa fa-circle"
                                                                role="img"
                                                                aria-label="Active"
                                                                title="Active"
                                                            />
                                                        </li>
                                                        <li
                                                            class="text-danger float-end mb4"
                                                            t-if="record.im_status.raw_value != 'online'"
                                                            title="Offline"
                                                        >
                                                            <i
                                                                class="fa fa-circle"
                                                                role="img"
                                                                aria-label="Inactive"
                                                                title="Inactive"
                                                            />
                                                        </li>
                                                        <li class="mb4">
                                                            <strong>
                                                                <field name="name" />
                                                            </strong>
                                                        </li>
                                                        <li
                                                            class="badge rounded-pill float-end mb4"
                                                            t-if="record.lang.raw_value"
                                                        >
                                                            <field name="lang" />
                                                        </li>
                                                        <li
                                                            class="mb4"
                                                            t-if="record.login.raw_value"
                                                            title="Login"
                                                        >
                                                            <i
                                                                class="fa fa-envelope"
                                                                role="img"
                                                                aria-label="Login"
                                                            />
                                                            <field name="login" />
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_backend" model="ir.actions.act_window">
        <field name="name">WhatsApp Backends</field>
        <field name="res_model">whatsapp.backend</field>
        <field name="view_mode">tree,form</field>
        <field
            name="view_id"
            ref="whatsapp_cloud_api_backend.view_whatsapp_backend_tree"
        />
        <field
            name="groups_id"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user')), (4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_manager'))]"
        />
    </record>

    <menuitem
        id="menu_whatsapp_backend_root"
        name="WhatsApp"
        sequence="15"
        groups="whatsapp_cloud_api_backend.group_whatsapp_backend_user,whatsapp_cloud_api_backend.group_whatsapp_backend_manager"
        web_icon="whatsapp_cloud_api_backend,static/description/icon.png"
    />

    <menuitem
        id="menu_whatsapp_backend"
        name="Backends"
        parent="menu_whatsapp_backend_root"
        action="action_whatsapp_backend"
        sequence="10"
        groups="whatsapp_cloud_api_backend.group_whatsapp_backend_user,whatsapp_cloud_api_backend.group_whatsapp_backend_manager"
    />
</odoo>
