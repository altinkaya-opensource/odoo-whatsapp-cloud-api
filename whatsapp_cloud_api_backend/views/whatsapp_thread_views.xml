<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_whatsapp_thread_tree" model="ir.ui.view">
        <field name="name">whatsapp.thread.tree</field>
        <field name="model">whatsapp.thread</field>
        <field name="arch" type="xml">
            <tree default_order="last_message_date desc">
                <field name="name" />
                <field name="backend_id" />
                <field name="partner_id" />
                <field name="phone_number" />
                <field name="last_message_date" />
                <field name="last_message_preview" />
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_thread_form" model="ir.ui.view">
        <field name="name">whatsapp.thread.form</field>
        <field name="model">whatsapp.thread</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Thread">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="backend_id" />
                            <field name="company_id" readonly="1" />
                        </group>
                        <group>
                            <field name="partner_id" />
                            <field name="phone_number" />
                            <field name="last_message_date" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <field name="last_message_preview" nolabel="1" readonly="1" />
                    </group>
                    <notebook>
                        <page string="WhatsApp Messages">
                            <field name="whatsapp_message_ids" readonly="1">
                                <tree default_order="create_date desc">
                                    <field name="create_date" />
                                    <field name="direction" />
                                    <field name="status" />
                                    <field name="message_type" />
                                    <field name="message_id" />
                                    <field name="body" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_thread_search" model="ir.ui.view">
        <field name="name">whatsapp.thread.search</field>
        <field name="model">whatsapp.thread</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Threads">
                <field name="name" />
                <field name="phone_number" />
                <field name="partner_id" />
            </search>
        </field>
    </record>

    <record id="action_whatsapp_thread" model="ir.actions.act_window">
        <field name="name">WhatsApp Threads</field>
        <field name="res_model">whatsapp.thread</field>
        <field name="view_mode">tree,form</field>
        <field
            name="view_id"
            ref="whatsapp_cloud_api_backend.view_whatsapp_thread_tree"
        />
        <field
            name="search_view_id"
            ref="whatsapp_cloud_api_backend.view_whatsapp_thread_search"
        />
        <field
            name="groups_id"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user')), (4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_manager'))]"
        />
    </record>

    <menuitem
        id="menu_whatsapp_thread"
        name="Threads"
        parent="whatsapp_cloud_api_backend.menu_whatsapp_backend_root"
        action="action_whatsapp_thread"
        sequence="30"
        groups="whatsapp_cloud_api_backend.group_whatsapp_backend_user,whatsapp_cloud_api_backend.group_whatsapp_backend_manager"
    />
</odoo>
