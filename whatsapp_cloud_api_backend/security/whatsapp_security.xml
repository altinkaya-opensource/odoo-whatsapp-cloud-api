<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="category_whatsapp_backend" model="ir.module.category">
        <field name="name">WhatsApp Backend</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_whatsapp_backend_user" model="res.groups">
        <field name="name">WhatsApp Backend User</field>
        <field
            name="category_id"
            ref="whatsapp_cloud_api_backend.category_whatsapp_backend"
        />
    </record>

    <record id="group_whatsapp_backend_manager" model="res.groups">
        <field name="name">WhatsApp Backend Manager</field>
        <field
            name="category_id"
            ref="whatsapp_cloud_api_backend.category_whatsapp_backend"
        />
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_backend_user'))]" />
    </record>

    <record id="rule_whatsapp_backend_user" model="ir.rule">
        <field name="name">WhatsApp Backends: assigned backends</field>
        <field
            name="model_id"
            ref="whatsapp_cloud_api_backend.model_whatsapp_backend"
        />
        <field name="domain_force">
            [('user_ids', 'in', user.id)]
        </field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user'))]"
        />
    </record>

    <record id="rule_whatsapp_backend_manager" model="ir.rule">
        <field name="name">WhatsApp Backends: all backends for managers</field>
        <field
            name="model_id"
            ref="whatsapp_cloud_api_backend.model_whatsapp_backend"
        />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_manager'))]"
        />
    </record>

    <record id="rule_whatsapp_message_report_user" model="ir.rule">
        <field name="name">WhatsApp Statistics: assigned backends</field>
        <field
            name="model_id"
            ref="whatsapp_cloud_api_backend.model_whatsapp_message_report"
        />
        <field name="domain_force">
            [('backend_id.user_ids', 'in', user.id)]
        </field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user'))]"
        />
    </record>

    <record id="rule_whatsapp_message_report_manager" model="ir.rule">
        <field name="name">WhatsApp Statistics: all backends for managers</field>
        <field
            name="model_id"
            ref="whatsapp_cloud_api_backend.model_whatsapp_message_report"
        />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_manager'))]"
        />
    </record>

    <record id="rule_whatsapp_message_user" model="ir.rule">
        <field name="name">WhatsApp Messages: assigned backends</field>
        <field
            name="model_id"
            ref="whatsapp_cloud_api_backend.model_whatsapp_message"
        />
        <field name="domain_force">
            [('backend_id.user_ids', 'in', user.id)]
        </field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user'))]"
        />
    </record>

    <record id="rule_whatsapp_thread_user" model="ir.rule">
        <field name="name">WhatsApp Threads: assigned backends</field>
        <field name="model_id" ref="whatsapp_cloud_api_backend.model_whatsapp_thread" />
        <field name="domain_force">
            [('backend_id.user_ids', 'in', user.id)]
        </field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user'))]"
        />
    </record>

    <record id="rule_whatsapp_thread_member_user" model="ir.rule">
        <field name="name">WhatsApp Thread Readers: own read position</field>
        <field
            name="model_id"
            ref="whatsapp_cloud_api_backend.model_whatsapp_thread_member"
        />
        <field name="domain_force">
            [('user_id', '=', user.id)]
        </field>
        <field
            name="groups"
            eval="[(4, ref('whatsapp_cloud_api_backend.group_whatsapp_backend_user'))]"
        />
    </record>
</odoo>
