ODOO_JSONRPC_PROTOCOL=http
ODOO_JSONRPC_HOST=odoo-hostname.example.com
ODOO_JSONRPC_PORT=8069
ODOO_JSONRPC_DATABASE=your_database

# Real-time updates come from Odoo's bus. Set this only when Odoo serves its
# websocket somewhere else than /websocket next to JSON-RPC (multi-worker Odoo
# serves it on the gevent port, usually routed by nginx).
ODOO_WEBSOCKET_URL=

# AI Chat Improvement Feature
AI_CHAT_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=openai/gpt-4o

# RAG-based AI Response Generation
# Set this URL to enable the RAG AI response generator feature
# The endpoint should accept POST requests with { "messages": "conversation text" }
# and return { "response": "generated response text" }
RAG_SUPPORTED_CHAT_URL=
